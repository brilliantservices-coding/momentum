# Copy to infra/config.env and fill in. Never commit config.env.
PROJECT_ID=your-gcp-project-id
REGION=asia-south1
# Monthly cap in your billing account's currency (INR or USD). The kill switch trips at 100%.
BUDGET_AMOUNT=2500
BUDGET_CURRENCY=INR
# Google account(s) allowed into the portal, comma-separated.
OWNER_EMAILS=you@gmail.com,other@gmail.com
# Of those, who may run agents and change settings (default: all OWNER_EMAILS). The rest see a read-only portal.
ADMIN_EMAILS=
# Extra read-only viewers, comma-separated. "*" lets in any Google account that passes the sign-in screen
# (the OAuth consent screen must then be published, or each viewer added as a test user).
VIEWER_EMAILS=
# Optional: Google Drive folder id where a scheduled task drops announcement CSVs.
# Share the folder (Viewer) with mb-agents@<project>.iam.gserviceaccount.com.
DRIVE_INBOX_ID=
