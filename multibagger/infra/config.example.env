# Copy to infra/config.env and fill in. Never commit config.env.
PROJECT_ID=your-gcp-project-id
REGION=asia-south1
# Monthly cap in your billing account's currency (INR or USD). The kill switch trips at 100%.
BUDGET_AMOUNT=2500
BUDGET_CURRENCY=INR
# Google account(s) allowed into the portal, comma-separated.
OWNER_EMAILS=you@gmail.com,other@gmail.com
