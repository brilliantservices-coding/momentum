# Copy to infra/config.env and fill in. Never commit config.env.
PROJECT_ID=your-gcp-project-id
REGION=asia-south1
# Monthly budget alert (emails at 50/90/100%) for everything labelled app=momentum, including the Kite VM.
BUDGET_AMOUNT=1500
BUDGET_CURRENCY=INR
# Google account(s) allowed into the portal, comma-separated.
OWNER_EMAILS=you@gmail.com
# When the weekly review runs (cron, Asia/Kolkata). Default: Saturday 08:00, after Friday's close.
SCHEDULE="0 8 * * 6"

# Zerodha Kite Connect app (API key only; the API secret lives in Secret Manager as mom-kite-api-secret)
KITE_API_KEY=
